APP_NAME="АСУ Мои Дома Light"
APP_ENV=production
APP_DEBUG=false
# Генерируется автоматически при первом старте контейнера, если пусто.
APP_KEY=
APP_URL=http://82.114.226.241:3333
APP_TIMEZONE=Europe/Moscow

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=asu_light
DB_USERNAME=asu_light
DB_PASSWORD=change_me_db_password

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# Срок жизни токена авторизации, минут (720 = 12 часов)
SANCTUM_TOKEN_EXPIRATION=720

# Внешний сервис «Кондуктор»
CONDUCTOR_URL=https://api.regenergy.ru/api2/asu/
CONDUCTOR_TIMEOUT=60
CONDUCTOR_CONNECT_TIMEOUT=10
CONDUCTOR_VERIFY_SSL=true
# CONDUCTOR_AUTH_HEADER=Authorization
# CONDUCTOR_AUTH_VALUE="Bearer xxxxx"

# Начальный superadmin (создаётся при первом старте, если не существует)
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=change_me_admin_password
SUPERADMIN_NAME="Суперадминистратор"

# Apple: для подстановки логина и пароля из связки ключей в iOS-приложении
# (файл /.well-known/apple-app-site-association). Team ID — в Apple Developer → Membership.
APPLE_TEAM_ID=
APPLE_APP_BUNDLE_ID=kz.synapse.asulight
